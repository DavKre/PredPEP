/* Browser test for the residue picker's four sections and the L/D rule.
 *
 * Feeds residues.js a payload generated by the real residue_catalogue.py, in a
 * minimal DOM carrying the IDs the shipping markup already uses. The point is
 * the LOGIC -- section split, mirror exclusion, palette mode, long type names
 * -- which does not depend on the template's styling.
 */
// Playwright is resolved from node_modules by default; set PLAYWRIGHT to an
// absolute path if it lives outside this directory's resolution chain, e.g.
//   PLAYWRIGHT=/opt/predpep-devtools/node_modules/playwright/index.js
const _pw = await import(process.env.PLAYWRIGHT || 'playwright');
const { chromium } = _pw.default || _pw;
import fs from 'fs';
import path from 'path';
import os from 'os';
import { spawn, execFileSync } from 'child_process';

// Where residue_catalogue.py and residues.js live. Found rather than assumed:
// this file sits at the app root on the node and in a js/ subdirectory in the
// working copy, so a fixed ../ is wrong in one of the two.
const SELF = path.dirname(new URL(import.meta.url).pathname);
function findApp(start) {
  let d = start;
  for (let i = 0; i < 4; i++) {
    if (fs.existsSync(path.join(d, 'residue_catalogue.py'))) return d;
    const up = path.resolve(d, '..');
    if (up === d) break;
    d = up;
  }
  return start;
}
const APP = process.env.PREDPEP_APP || findApp(SELF);
const HERE = fs.existsSync(path.join(APP, 'static/js/residues.js'))
  ? path.join(APP, 'static/js')
  : SELF;
if (!fs.existsSync(path.join(HERE, 'residues.js'))) {
  console.error(`could not find residues.js (looked in ${HERE}).\n`
    + `Set PREDPEP_APP to the directory holding residue_catalogue.py.`);
  process.exit(1);
}
if (!fs.existsSync(path.join(APP, 'residue_catalogue.py'))) {
  console.error(`could not find residue_catalogue.py (looked in ${APP}).\n`
    + `Set PREDPEP_APP to the directory holding it.`);
  process.exit(1);
}
console.log(`app: ${APP}\nmodule: ${path.join(HERE, 'residues.js')}`);
const OUT = fs.mkdtempSync(path.join(os.tmpdir(), 'resj-'));
fs.copyFileSync(path.join(HERE, 'residues.js'), path.join(OUT, 'residues.js'));

// The payload comes from the REAL residue_catalogue.py, not a checked-in
// fixture: a fixture would go stale the moment the catalogue changes, and the
// point of running this on the node is to test the picker against what the
// node actually offers.
execFileSync('python3', ['-c', `
import json, sys
sys.path.insert(0, ${JSON.stringify(APP)})
import residue_catalogue as rc
json.dump(rc.public_payload(), open(${JSON.stringify(path.join(OUT, 'catalogue.json'))}, 'w'))
`], { stdio: 'inherit' });
const payload = JSON.parse(fs.readFileSync(path.join(OUT, 'catalogue.json'), 'utf8'));
const D_CANON = 'D-canonical';
const want = {
  canonical: payload.canonical.length,
  lNon: payload.noncanonical.filter(e => e.hand !== 'D').length,
  dCanon: payload.noncanonical.filter(e => e.hand === 'D' &&
                                           e.category === D_CANON).length,
  dNon: payload.noncanonical.filter(e => e.hand === 'D' &&
                                         e.category !== D_CANON).length,
};
console.log(`catalogue: ${want.canonical} canonical, ${want.lNon} L, ` +
            `${want.dCanon} D-canonical, ${want.dNon} D-non-canonical`);
// Two real codes to drive the exclusion checks, picked from the payload so
// the test does not depend on 0A1 in particular still being installed.
const pair = payload.noncanonical.find(e =>
  e.hand === 'D' && e.category !== D_CANON &&
  payload.noncanonical.some(x => x.hand !== 'D' && x.l_code === e.l_code));
if (!pair) {
  console.error(payload.error
    ? `the catalogue could not be read: ${payload.error}`
    : 'no L/D pair in the catalogue; nothing to test. Set '
      + 'PREDPEP_RESIDUE_CSV / PREDPEP_PARAMS_DIR / PREDPEP_ROTLIB_DIR if the '
      + 'catalogue lives somewhere other than the defaults.');
  process.exit(1);
}
const D_CODE = pair.code;
const L_CODE = payload.noncanonical.find(x => x.hand !== 'D' &&
                                              x.l_code === pair.l_code).code;
console.log(`exclusion pair: ${L_CODE} / ${D_CODE}`);

// Stub for ./api.js -- residues.js imports { api, esc } from it.
fs.writeFileSync(path.join(OUT, 'api.js'), `
export const esc = s => String(s).replace(/[&<>"']/g,
  c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
export const api = {
  residues: () => fetch('./catalogue.json').then(r => r.json()),
};
`);

fs.writeFileSync(path.join(OUT, 'index.html'), `<!doctype html>
<meta charset="utf-8"><title>picker</title>
<body>
  <p id="residueSummary"></p><span id="residueCount"></span>
  <button id="openResiduePicker">Choose residues</button>
  <div id="residueModal" hidden>
    <input id="residueSearch">
    <input type="checkbox" id="residueOnlyRotlib">
    <input type="checkbox" id="residueOnlyFoldx">
    <input type="checkbox" id="residueHideD">
    <div id="residueSections"></div>
    <span id="residueModalCount"></span>
    <button id="residueApply">Apply</button>
    <button id="residueClearAll">Clear</button>
    <button data-res-close>Close</button>
  </div>
<script type="module">
  import * as R from './residues.js';
  window.R = R;
  R.init(() => { window.__changed = (window.__changed || 0) + 1; });
  const wait = setInterval(() => {
    if (!document.getElementById('residueSummary').textContent
         .includes('Loading')) { window.__ready = true; clearInterval(wait); }
  }, 30);
</script></body>`);

const fails = [];
const check = (label, got, want) => {
  const ok = JSON.stringify(got) === JSON.stringify(want);
  console.log(`  ${ok ? 'ok  ' : 'FAIL'}  ${label}: ${JSON.stringify(got)}`
    + (ok ? '' : `   (want ${JSON.stringify(want)})`));
  if (!ok) fails.push(label);
};

const srv = spawn('python3', ['-m', 'http.server', '8763', '--bind', '127.0.0.1'],
                  { cwd: OUT, stdio: 'ignore' });
await new Promise(r => setTimeout(r, 700));
const browser = await chromium.launch();
const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });
const errs = [];
page.on('pageerror', e => errs.push(String(e)));
page.on('console', m => { if (m.type() === 'error') errs.push(m.text()); });
await page.goto('http://127.0.0.1:8763/index.html');
await page.waitForFunction(() => window.__ready, null, { timeout: 15000 });

console.log('\n[1] the collapsed summary names L and D separately');
check('summary', await page.$eval('#residueSummary', e => e.textContent.trim()),
  `Canonical twenty only — ${payload.counts.l_offerable} L and ` +
  `${payload.counts.d_offerable} D residues available.`);

await page.click('#openResiduePicker');
await page.waitForTimeout(250);

console.log('\n[2] four sections, in order, with their own counts');
check('titles', await page.$$eval('#residueSections .res-section__title',
  n => n.map(x => x.textContent.trim())),
  [`L-canonical (${want.canonical})`, `L-non-canonical (${want.lNon})`,
   `D-canonical (${want.dCanon})`, `D-non-canonical (${want.dNon})`]);
check('one note per section, in order',
  await page.$$eval('#residueSections .chart-note', n => n.length), 4);
check('each D section has a description',
  await page.$$eval('#residueSections .res-section',
    s => s.slice(2).map(x => !!x.querySelector('.chart-note'))), [true, true]);
check('the D-canonical note explains the het code',
  await page.$$eval('#residueSections .chart-note',
    n => n[2].textContent.includes('DAL, DAR, DSG')), true);
check('the D-non-canonical note explains the shared code',
  await page.$$eval('#residueSections .chart-note',
    n => n[3].textContent.includes('under its L parent')), true);

console.log('\n[3] L-canonical stays locked, the D sections do not');
check('canonical boxes disabled',
  await page.$$eval('#residueSections .res-section', s =>
    [...s[0].querySelectorAll('input')].every(b => b.disabled && b.checked)),
  true);
check('D-canonical boxes selectable',
  await page.$$eval('#residueSections .res-section', s =>
    [...s[2].querySelectorAll('input')].every(b => !b.disabled)), true);

console.log('\n[4] a long Rosetta type name is shown short, with the real one in the title');
check('chip reads BIF', await page.$eval('[data-code="BiphenylAlanine"] .res',
  e => e.textContent), 'BIF');
check('title gives the type name',
  await page.$eval('[data-code="BiphenylAlanine"] .res', e => e.title),
  'Rosetta type name: BiphenylAlanine');
check('its mirror reads DBIF',
  await page.$eval('[data-code="DBiphenylAlanine"] .res', e => e.textContent),
  'DBIF');
check('D chips use the dres class',
  await page.$eval('[data-code="DBiphenylAlanine"] .res',
    e => e.className.includes('dres')), true);

console.log('\n[5] searching the short code finds the long type');
await page.fill('#residueSearch', 'BIF');
await page.waitForTimeout(150);
check('both hands found', await page.$$eval('#residueSections .res-row',
  rows => rows.filter(r => !r.hidden).map(r => r.dataset.code)),
  ['BiphenylAlanine', 'DBiphenylAlanine']);
// BIF is only present when Rosetta supplies it; skipped otherwise.
await page.fill('#residueSearch', '');
await page.waitForTimeout(150);

console.log('\n[6] selecting a residue blocks its mirror, and only its mirror');
await page.check(`[data-code="${L_CODE}"] input`);
await page.waitForTimeout(120);
check('the mirror is disabled',
  await page.$eval(`[data-code="${D_CODE}"] input`, b => b.disabled), true);
check('and marked blocked',
  await page.$eval(`[data-code="${D_CODE}"]`,
    r => r.className.includes('res-row--blocked')), true);
check('the reason names the blocker',
  // The blocker is the L parent, and it must be named -- passed in as an
  // argument because the callback runs in the page, not in node.
  await page.$eval(`[data-code="${D_CODE}"]`,
    (r, blocker) => r.title.includes(blocker), L_CODE), true);
check('an unrelated residue is untouched',
  await page.$eval('[data-code="D0AF"] input', b => b.disabled), false);
check('count reports it', await page.$eval('#residueModalCount',
  e => e.textContent), '1 non-canonical residue selected');

console.log('\n[7] unticking releases the mirror -- state is recomputed, not toggled');
await page.uncheck(`[data-code="${L_CODE}"] input`);
await page.waitForTimeout(120);
check('mirror free again',
  await page.$eval(`[data-code="${D_CODE}"] input`, b => b.disabled), false);
check('blocked class gone',
  await page.$eval(`[data-code="${D_CODE}"]`,
    r => r.className.includes('res-row--blocked')), false);

console.log('\n[8] the rule holds in the other direction too');
await page.check(`[data-code="${D_CODE}"] input`);
await page.waitForTimeout(120);
check('the L parent is blocked',
  await page.$eval(`[data-code="${L_CODE}"] input`, b => b.disabled), true);
check('count flags the D', await page.$eval('#residueModalCount',
  e => e.textContent), '1 non-canonical residue selected (1 D)');

console.log('\n[9] palette mode follows the committed selection');
await page.click('#residueApply');
await page.waitForTimeout(150);
check('all D non-canonical -> d-mixed',
  await page.evaluate(() => window.R.paletteMode()), 'd-mixed');
check('onChange fired', await page.evaluate(() => window.__changed > 0), true);
await page.click('#openResiduePicker');
await page.waitForTimeout(200);
check('the committed box is still ticked',
  await page.$eval(`[data-code="${D_CODE}"] input`, b => b.checked), true);
await page.uncheck(`[data-code="${D_CODE}"] input`);
await page.check('[data-code="DALA"] input');
await page.click('#residueApply');
await page.waitForTimeout(150);
check('only D-canonicals -> d-canonical',
  await page.evaluate(() => window.R.paletteMode()), 'd-canonical');
await page.click('#openResiduePicker');
await page.waitForTimeout(200);
await page.check(`[data-code="${L_CODE}"] input`);
await page.click('#residueApply');
await page.waitForTimeout(150);
check('a mix -> all-mixed',
  await page.evaluate(() => window.R.paletteMode()), 'all-mixed');
check('selected() returns the real palette names',
  await page.evaluate(() => window.R.selected()), [L_CODE, 'DALA'].sort());
await page.evaluate(() => window.R.reset());
check('reset -> l-canonical',
  await page.evaluate(() => window.R.paletteMode()), 'l-canonical');

console.log('\n[10] "Select all shown" respects the rule across sections');
await page.click('#openResiduePicker');
await page.waitForTimeout(200);
await page.fill('#residueSearch', L_CODE);
await page.waitForTimeout(150);
// Section 4 (D-non-canonical) -> select all shown, which is D0A1 alone.
await page.$$eval('#residueSections .res-section', s => {
  const btn = [...s[3].querySelectorAll('.chip')]
    .find(b => b.textContent === 'Select all shown');
  btn.click();
});
await page.waitForTimeout(150);
check('D0A1 selected', await page.$eval(`[data-code="${D_CODE}"] input`,
  b => b.checked), true);
check('its L parent is now blocked',
  await page.$eval(`[data-code="${L_CODE}"] input`, b => b.disabled), true);
check('and was not also selected',
  await page.$eval(`[data-code="${L_CODE}"] input`, b => b.checked), false);

console.log('\n[11] the L-only filter hides the D rows without unselecting them');
await page.fill('#residueSearch', '');
await page.check('#residueHideD');
await page.waitForTimeout(150);
check('no D row visible', await page.$$eval('#residueSections .res-row',
  rows => rows.filter(r => !r.hidden && r.dataset.hand === 'D').length), 0);
check('L rows still visible', await page.$$eval('#residueSections .res-row',
  rows => rows.filter(r => !r.hidden).length > 100), true);
check('the selection survived',
  await page.evaluate(() => document.getElementById('residueModalCount')
    .textContent), '1 non-canonical residue selected (1 D)');
await page.uncheck('#residueHideD');

console.log('\n[12] markers say what each kind of residue costs');
check('a D non-canonical warns about the shared code',
  await page.$eval(`[data-code="${D_CODE}"] .small`, e =>
    e.textContent.includes('shares its L code')), true);
check('a D canonical does not',
  await page.$eval('[data-code="DALA"] .small', e =>
    e.textContent.includes('shares its L code')), false);
check('a D canonical names its PDB code in the tooltip',
  await page.$eval('[data-code="DALA"] .small', e =>
    e.title.includes('Written into the output PDB as DAL')), true);
const supplied = payload.noncanonical.find(e => e.source === 'rosetta' &&
                                                e.hand !== 'D');
if (supplied) {
  check('a Rosetta-supplied L reports rotamers as unknown, not missing',
    await page.$eval(`[data-code="${supplied.code}"] .small`, e =>
      e.textContent.includes('1 rotamer')), false);
}
check('provenance is a tag, not a section',
  await page.$eval(`[data-code="${L_CODE}"] .small`, e =>
    e.textContent.includes('name') || e.textContent.includes('match')), true);

await page.screenshot({ path: path.join(OUT, 'picker.png'), fullPage: false });
await browser.close();
srv.kill();
fs.rmSync(OUT, { recursive: true, force: true });
console.log('\npage errors: ' + (errs.length ? errs.slice(0, 3).join(' | ') : 'none'));
if (errs.length) fails.push('page errors');
console.log('FAILURES: ' + (fails.length ? fails.join(', ') : 'none'));
process.exit(fails.length ? 1 : 0);
